{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prettify_json",
      "group": "build",
      "type": "shell",
      "command": "python .vscode/prettify_json.py",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "install pre-commit hook",
      "type": "shell",
      "command": "git config core.hooksPath .vscode",
      "problemMatcher": []
    },
    {
      "label": "watch_extract_st",
      "type": "shell",
      "command": "python .vscode/watch_extract_st.py",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "extract_st",
      "group": "build",
      "type": "shell",
      "command": "python .vscode/extract_st.py",
      "problemMatcher": [
        "$python"
      ],
      "dependsOn": []
    },
    {
      "label": "update_st",
      "group": "build",
      "type": "shell",
      "command": "python .vscode/update_st.py",
      "problemMatcher": [
        "$python"
      ],
      "dependsOn": []
    },
    {
      "label": "update_version",
      "type": "shell",
      "command": "python .vscode/update_version.py",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "update_version --dry-run",
      "type": "shell",
      "command": "python .vscode/update_version.py --dry-run",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "create_release",
      "type": "shell",
      "command": "python .vscode/create_release.py",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "create_release --dry-run",
      "type": "shell",
      "command": "python .vscode/create_release.py --dry-run",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "remove .gitignore",
      "type": "shell",
      "command": "if (Test-Path -LiteralPath .gitignore) { Remove-Item -LiteralPath .gitignore }"
    },
    {
      "label": "run tests",
      "group": "test",
      "type": "shell",
      "command": "python -m unittest discover -v -s .vscode -t .",
      "problemMatcher": [
        "$python"
      ]
    }
  ]
}
